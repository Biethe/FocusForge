# --- Model weights are NEVER committed (privacy + license rule) ---
models/
*.gguf
*.task
*.tflite

# --- Android / Gradle ---
*.apk
*.aab
*.ap_
*.dex
.gradle/
build/
captures/
local.properties
*.keystore
*.jks
# exception: the debug-only keystore is committed so CI builds keep one signature
!app/debug.keystore

# --- Android Studio / IntelliJ ---
.idea/
*.iml
.navigation/

# --- Native build output ---
.cxx/
obj/
*.o
*.so

# --- Kotlin/JVM ---
*.class
*.log
*.hprof

# --- OS noise ---
.DS_Store
Thumbs.db

# Windows "downloaded from the internet" metadata, created when files are copied from the phone via WSL
*:Zone.Identifier

# Saved phone address for scripts/sync-device.sh — local, and not the same on any two machines
.device

# Screenshots pulled off the phone are STAGED here and never auto-committed: a phone's
# screenshot folder is the operator's whole life, and the Session screen shows their face.
docs/screenshots/incoming/
